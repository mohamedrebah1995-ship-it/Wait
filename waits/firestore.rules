rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The delegated admin (matches the app's hasAdminPerks check).
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'contact.morebah@gmail.com';
    }

    // Users can read their own profile and edit most of it, but premium/subscriptionId are
    // LOCKED — only the Stripe webhook (Admin SDK, which bypasses these rules) can change them,
    // so a driver can't self-grant Premium by writing their own doc.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('premium', false) == false;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('premium', false) == resource.data.get('premium', false)
        && request.resource.data.get('subscriptionId', null) == resource.data.get('subscriptionId', null);
      allow delete: if false;
      // Personal earnings log — strictly private to that driver
      match /earnings/{earningId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Shift clock-in/out records — strictly private to that driver
      match /shifts/{shiftId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Wait logs — the crowd data. Create-only (the client never edits/deletes them) with a
    // sanity-checked wait time so garbage/abusive values can't poison the community averages.
    match /waitLogs/{logId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.restaurantId is string
        && request.resource.data.waitMins is number
        && request.resource.data.waitMins >= 0
        && request.resource.data.waitMins <= 600;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Location votes (Manual Arrive) — create-only, with valid coordinates.
    match /locationVotes/{voteId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.restaurantId is string
        && request.resource.data.lat is number && request.resource.data.lat >= -90  && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
      allow update, delete: if false;
    }

    // Crowd-sourced pinned restaurant locations — valid coords; an admin-pinned PERMANENT
    // location cannot be overwritten or have `permanent` set by anyone but the admin.
    match /restaurantLocations/{restaurantId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.lat is number && request.resource.data.lat >= -90  && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && ( isAdmin()
             || ( request.resource.data.get('permanent', false) != true
                  && (resource == null || resource.data.get('permanent', false) != true) ) );
      allow delete: if isAdmin();
    }

    // Driver-reported "drivers waiting now" counts — sane count range, no cross-user deletes.
    match /restaurantCounts/{restaurantId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.count is number
        && request.resource.data.count >= 0 && request.resource.data.count <= 999;
      allow delete: if isAdmin();
    }

    // Area-specific long-queue alerts (ephemeral, 20-min TTL on read).
    match /queueAlerts/{alertId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.ts is string;
      allow delete: if isAdmin();
    }

    // Live "waiting now" presence — anyone reads, you only write your own.
    match /activeWaits/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Driver roster (for the live driver count) — read by all, you only write your own (no PII).
    match /drivers/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Area chat rooms (subcollections) — any authenticated user can read/write
    // (admin moderation/deletes are handled in-app; messages are keyed by username, not uid).
    match /chats/{room}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    // Legacy messages collection
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
  }
}
